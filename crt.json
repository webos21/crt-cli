{
  "manifest_format": 0,
  "package": {
    "name": "crt-cli",
    "version": "0.1.0-dev"
  },
  "sdk": {
    "profile": "dev",
    "version": "*",
    "target": "native",
    "storage": "shared-immutable"
  },
  "include_dirs": [
    "include"
  ],
  "application": {
    "name": "crt-cli",
    "sources": [
      "src/main/main.cpp",
      "src/main/bootstrap.cpp",
      "src/main/core.cpp",
      "src/main/process.cpp",
      "src/main/environment.cpp",
      "src/main/toolchain.cpp",
      "src/main/project.cpp",
      "src/main/http.cpp",
      "src/main/fetch.cpp",
      "src/main/publisher.cpp",
      "src/main/host_tools.cpp",
      "src/main/diagnostics.cpp",
      "src/main/archive.cpp",
      "src/main/sdk_store.cpp",
      "src/main/sdk_command.cpp",
      "src/main/sdk_acquire.cpp",
      "src/main/port_recipe.cpp",
      "src/main/port_build.cpp",
      "src/main/port_store.cpp"
    ],
    "sdk_consumer_option_sources": [
      "src/main/http.cpp"
    ],
    "sdk_libraries": [
      "curl",
      "mbedtls",
      "mbedx509",
      "mbedcrypto",
      "z",
      "lzma"
    ]
  },
  "tests": [
    {
      "name": "native-test",
      "timeout_seconds": 3600,
      "sources": [
        "src/test/native_test.cpp",
        "src/main/core.cpp",
        "src/main/process.cpp",
        "src/main/environment.cpp"
      ],
      "sdk_libraries": [
        "mbedcrypto"
      ]
    },
    {
      "name": "archive-test",
      "timeout_seconds": 600,
      "sources": [
        "src/test/archive_test.cpp",
        "src/main/archive.cpp",
        "src/main/core.cpp",
        "src/main/process.cpp",
        "src/main/environment.cpp"
      ],
      "sdk_libraries": [
        "lzma",
        "z",
        "mbedcrypto"
      ]
    },
    {
      "name": "sdk-store-test",
      "timeout_seconds": 600,
      "sources": [
        "src/test/sdk_store_test.cpp",
        "src/main/sdk_store.cpp",
        "src/main/archive.cpp",
        "src/main/core.cpp",
        "src/main/process.cpp",
        "src/main/environment.cpp"
      ],
      "sdk_libraries": [
        "lzma",
        "z",
        "mbedcrypto"
      ]
    },
    {
      "name": "port-recipe-test",
      "timeout_seconds": 600,
      "sources": [
        "src/test/port_recipe_test.cpp",
        "src/main/port_recipe.cpp",
        "src/main/archive.cpp",
        "src/main/core.cpp",
        "src/main/process.cpp",
        "src/main/environment.cpp"
      ],
      "sdk_libraries": [
        "lzma",
        "z",
        "mbedcrypto"
      ]
    },
    {
      "name": "port-build-test",
      "timeout_seconds": 1800,
      "sources": [
        "src/test/port_build_test.cpp",
        "src/main/port_build.cpp",
        "src/main/port_recipe.cpp",
        "src/main/host_tools.cpp",
        "src/main/sdk_store.cpp",
        "src/main/toolchain.cpp",
        "src/main/archive.cpp",
        "src/main/core.cpp",
        "src/main/process.cpp",
        "src/main/environment.cpp"
      ],
      "sdk_libraries": [
        "lzma",
        "z",
        "mbedcrypto"
      ]
    },
    {
      "name": "port-store-test",
      "timeout_seconds": 1800,
      "sources": [
        "src/test/port_store_test.cpp",
        "src/main/port_store.cpp",
        "src/main/port_build.cpp",
        "src/main/port_recipe.cpp",
        "src/main/host_tools.cpp",
        "src/main/sdk_store.cpp",
        "src/main/toolchain.cpp",
        "src/main/archive.cpp",
        "src/main/core.cpp",
        "src/main/process.cpp",
        "src/main/environment.cpp"
      ],
      "sdk_libraries": [
        "lzma",
        "z",
        "mbedcrypto"
      ]
    },
    {
      "name": "port-project-test",
      "timeout_seconds": 1800,
      "sources": [
        "src/test/port_project_test.cpp",
        "src/main/bootstrap.cpp",
        "src/main/core.cpp",
        "src/main/process.cpp",

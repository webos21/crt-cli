{
  "manifest_format": 0,
  "package": {
    "name": "crt-cli",
    "version": "0.1.0-dev"
  },
  "sdk": {
    "profile": "dev",
    "version": "*",
    "target": "native",
    "storage": "shared-immutable"
  },
  "include_dirs": [
    "include"
  ],
  "application": {
    "name": "crt-cli",
    "sources": [
      "src/main/main.cpp",
      "src/main/bootstrap.cpp",
      "src/main/core.cpp",
      "src/main/process.cpp",
      "src/main/toolchain.cpp",
      "src/main/project.cpp"
    ],
    "sdk_libraries": [
      "curl",
      "mbedtls",
      "mbedx509",
      "mbedcrypto",
      "z"
    ]
  },
  "tests": [
    {
      "name": "native-test",
      "timeout_seconds": 1800,
      "sources": [
        "src/test/native_test.cpp",
        "src/main/core.cpp",
        "src/main/process.cpp"
      ],
      "sdk_libraries": ["mbedcrypto"]
    }
  ]
}
